/**
 * app.wxss - 全局样式（方案A · 星空靛蓝）
 *
 * 设计变量统一在这里维护，页面样式一律引用变量，不要硬编码颜色。
 * 图标库见 styles/icons.wxss（由 tools/gen-icons.js 生成）。
 */
@import "./styles/icons.wxss";

page {
  /* ===== 主题色 ===== */
  --primary: #5B67F1;        /* 主色 · 靛蓝 */
  --primary-deep: #8E5CF6;   /* 主色渐变端 · 紫 */
  --grad-primary: linear-gradient(135deg, #5B67F1 0%, #8E5CF6 100%);
  --tint: #EDEFFF;           /* 主色淡背景（标签/选中态） */

  /* ===== 语义色 ===== */
  --ok: #22C08A;
  --ok-tint: #E5F8F1;
  --danger: #FF5C72;
  --danger-tint: #FFEDEF;
  --warning: #FFA940;
  --warning-tint: #FFF4E6;

  /* ===== 中性色 ===== */
  --bg: #F6F7FB;             /* 页面背景 */
  --panel: #FFFFFF;          /* 卡片背景 */
  --panel-2: #F1F2F8;        /* 次级背景（分段控件/输入框） */
  --t1: #252A3D;             /* 一级文字 */
  --t2: #5A6072;             /* 二级文字 */
  --t3: #9AA0B0;             /* 三级文字/占位 */
  --line: #E7E9F2;           /* 分割线/描边 */

  /* ===== 圆角与阴影 ===== */
  --r-lg: 24rpx;             /* 卡片圆角 */
  --r-md: 20rpx;             /* 按钮/输入框圆角 */
  --shadow: 0 8rpx 28rpx rgba(91, 103, 241, 0.08);
  --shadow-sm: 0 4rpx 16rpx rgba(37, 42, 61, 0.05);

  background-color: var(--bg);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  color: var(--t1);
  font-size: 28rpx;
  line-height: 1.6;
}

/* 通用容器 */
.container {
  padding: 30rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 卡片样式 */
.card {
  background: var(--panel);
  border-radius: var(--r-lg);
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm);
}

/* 主按钮 */
.btn-primary {
  background: var(--grad-primary);
  color: #fff;
  border-radius: var(--r-md);
  padding: 24rpx 40rpx;
  font-size: 30rpx;
  font-weight: 500;
  text-align: center;
  border: none;
  box-shadow: 0 8rpx 20rpx rgba(91, 103, 241, 0.25);
}

.btn-primary::after {
  border: none;
}

.btn-secondary {
  background: var(--panel);
  color: var(--primary);
  border: 2rpx solid var(--primary);
  border-radius: var(--r-md);
  padding: 22rpx 40rpx;
  font-size: 30rpx;
  text-align: center;
}

.btn-secondary::after {
  border: none;
}

.btn-danger {
  background: var(--danger);
  color: #fff;
  border-radius: var(--r-md);
  padding: 24rpx 40rpx;
  font-size: 30rpx;
  font-weight: 500;
  text-align: center;
  border: none;
  box-shadow: 0 8rpx 20rpx rgba(255, 92, 114, 0.25);
}

.btn-danger::after {
  border: none;
}

/* 标题 */
.page-title {
  font-size: 40rpx;
  font-weight: bold;
  color: var(--t1);
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--t1);
  margin-bottom: 20rpx;
}

/* 输入框 */
.input {
  background: var(--panel-2);
  border-radius: var(--r-md);
  padding: 24rpx 30rpx;
  font-size: 28rpx;
  margin-bottom: 24rpx;
  border: 2rpx solid transparent;
}

.input:focus {
  border-color: var(--primary);
  background: var(--panel);
}

/* 文本区域 */
.textarea {
  background: var(--panel-2);
  border-radius: var(--r-md);
  padding: 24rpx 30rpx;
  font-size: 28rpx;
  width: 100%;
  box-sizing: border-box;
  min-height: 160rpx;
}

/* 标签 */
.tag {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  background: var(--tint);
  color: var(--primary);
  margin-right: 12rpx;
}

.tag-success {
  background: var(--ok-tint);
  color: var(--ok);
}

.tag-warning {
  background: var(--warning-tint);
  color: var(--warning);
}

.tag-danger {
  background: var(--danger-tint);
  color: var(--danger);
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 120rpx 30rpx;
  color: var(--t3);
}

.empty-state .icon {
  font-size: 120rpx;
  margin-bottom: 20rpx;
}

.empty-state .text {
  font-size: 28rpx;
}

/* 列表项 */
.list-item {
  background: var(--panel);
  border-radius: var(--r-lg);
  padding: 30rpx;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: var(--shadow-sm);
}

.list-item:active {
  background: var(--panel-2);
}

/* 代码块 */
.code-block {
  background: #2A2D3E;
  color: #F8F8F2;
  border-radius: var(--r-md);
  padding: 24rpx;
  font-family: 'Courier New', monospace;
  font-size: 24rpx;
  line-height: 1.8;
  overflow-x: auto;
  white-space: pre-wrap;
  word-break: break-all;
}

.code-keyword {
  color: #FF79C6;
}

.code-string {
  color: #F1FA8C;
}

.code-comment {
  color: #7A81A8;
}

.code-number {
  color: #BD93F9;
}

/* 加载中 */
.loading {
  text-align: center;
  padding: 60rpx;
  color: var(--t3);
}

/* 底部间距 */
.bottom-space {
  height: 60rpx;
}

/* 行布局 */
.row {
  display: flex;
  align-items: center;
}

.row-space {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* 进度条 */
.progress-bar {
  width: 100%;
  height: 12rpx;
  background: var(--line);
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: var(--grad-primary);
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

/* 分割线 */
.divider {
  height: 1rpx;
  background: var(--line);
  margin: 20rpx 0;
}

/* 选项卡片 */
.option-item {
  background: var(--panel);
  border-radius: var(--r-md);
  padding: 24rpx 30rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid var(--line);
  transition: all 0.2s;
}

.option-item.selected {
  background: var(--tint);
  border-color: var(--primary);
}

.option-item.correct {
  background: var(--ok-tint);
  border-color: var(--ok);
}

.option-item.wrong {
  background: var(--danger-tint);
  border-color: var(--danger);
}

/* 浮动按钮 */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: var(--grad-primary);
  color: #fff;
  font-size: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(91, 103, 241, 0.4);
  z-index: 999;
}
