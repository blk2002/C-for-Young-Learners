/* pages/profile/profile.wxss */

.profile-page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 40rpx;
}

/* ===== 用户信息头部 ===== */
.user-hero {
  background: var(--grad-primary);
  padding: 40rpx 40rpx 110rpx;
  color: #fff;
  position: relative;
  overflow: hidden;
}

.hero-deco {
  position: absolute;
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.10);
  right: -70rpx;
  top: -90rpx;
}

.user-row {
  display: flex;
  align-items: center;
  position: relative;
  z-index: 2;
}

.avatar-wrap {
  flex: none;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(255, 255, 255, 0.55);
  background: rgba(255, 255, 255, 0.22);
}

.avatar-text {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
}

.user-meta {
  flex: 1;
  margin-left: 28rpx;
  overflow: hidden;
}

.display-name {
  font-size: 38rpx;
  font-weight: bold;
  letter-spacing: 1rpx;
}

.account {
  font-size: 24rpx;
  opacity: 0.82;
  margin-top: 6rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.role-chip {
  flex: none;
  background: rgba(255, 255, 255, 0.22);
  border: 1rpx solid rgba(255, 255, 255, 0.4);
  border-radius: 24rpx;
  padding: 6rpx 22rpx;
  font-size: 22rpx;
}

/* ===== 学习数据概览 ===== */
.stat-card {
  margin: -70rpx 40rpx 0;
  background: var(--panel);
  border-radius: 28rpx;
  padding: 34rpx 12rpx;
  display: flex;
  box-shadow: 0 8rpx 28rpx rgba(37, 42, 61, 0.07);
  position: relative;
  z-index: 3;
}

.stat-item {
  flex: 1;
  text-align: center;
  padding: 0 10rpx;
  border-right: 1rpx solid var(--line);
}

.stat-item:last-child {
  border-right: none;
}

.stat-item:active {
  opacity: 0.6;
}

.stat-num {
  font-size: 38rpx;
  font-weight: bold;
  color: var(--primary);
  line-height: 1.25;
}

/* 章节标题可能较长，用更小的字号 */
.stat-text {
  font-size: 27rpx;
  word-break: break-all;
}

.stat-label {
  font-size: 22rpx;
  color: var(--t3);
  margin-top: 6rpx;
}

/* ===== 功能菜单 ===== */
.menu-list {
  margin: 24rpx 40rpx 0;
  background: var(--panel);
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: var(--shadow-sm);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 30rpx;
  border-bottom: 1rpx solid var(--line);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background: var(--panel-2);
}

.menu-icon {
  flex: none;
  width: 62rpx;
  height: 62rpx;
  border-radius: 18rpx;
  background: var(--panel-2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.menu-body {
  flex: 1;
  margin-left: 22rpx;
}

.menu-text {
  font-size: 28rpx;
  color: var(--t1);
}

.menu-sub {
  font-size: 22rpx;
  color: var(--t3);
  margin-top: 2rpx;
}

.menu-arrow {
  flex: none;
  font-size: 30rpx;
  color: var(--t3);
}

.admin-item .menu-icon {
  background: var(--tint);
}

/* ===== 退出登录 ===== */
.logout-btn {
  margin: 40rpx 40rpx 0;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: var(--panel);
  color: var(--danger);
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 20rpx;
  border: 1rpx solid #FFD9DF;
}

.logout-btn:active {
  background: var(--danger-tint);
}
