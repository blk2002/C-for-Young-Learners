<!-- pages/change-password/change-password.wxml -->
<view class="container">
  <view class="form-section">
    <!-- 原密码 -->
    <view class="form-item">
      <view class="form-label">原密码</view>
      <input
        class="form-input"
        placeholder="请输入当前密码"
        placeholder-class="form-placeholder"
        value="{{oldPassword}}"
        bindinput="onOldPasswordInput"
        password="true"
        maxlength="20"
      />
    </view>

    <!-- 新密码 -->
    <view class="form-item">
      <view class="form-label">新密码</view>
      <input
        class="form-input"
        placeholder="请输入新密码（至少6位）"
        placeholder-class="form-placeholder"
        value="{{newPassword}}"
        bindinput="onNewPasswordInput"
        password="true"
        maxlength="20"
      />
    </view>

    <!-- 确认新密码 -->
    <view class="form-item">
      <view class="form-label">确认新密码</view>
      <input
        class="form-input"
        placeholder="请再次输入新密码"
        placeholder-class="form-placeholder"
        value="{{confirmPassword}}"
        bindinput="onConfirmPasswordInput"
        password="true"
        maxlength="20"
      />
    </view>
  </view>

  <view class="tip-text">密码至少 6 位。忘记密码？请联系老师为你重置。</view>

  <view class="save-section">
    <button class="save-btn" bindtap="onSubmit" disabled="{{saving}}">
      {{saving ? '提交中...' : '确认修改'}}
    </button>
  </view>
</view>
