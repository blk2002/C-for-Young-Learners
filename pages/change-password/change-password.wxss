/* pages/change-password/change-password.wxss */
.container {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 40rpx;
}

.form-section {
  margin: 30rpx 40rpx;
  background: var(--panel);
  border-radius: 20rpx;
  overflow: hidden;
}

.form-item {
  padding: 30rpx;
  border-bottom: 1rpx solid var(--line);
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  font-size: 26rpx;
  color: var(--t2);
  margin-bottom: 14rpx;
  font-weight: 500;
}

.form-input {
  font-size: 30rpx;
  color: var(--t1);
  height: 48rpx;
  min-height: 48rpx;
  line-height: 48rpx;
}

.form-placeholder {
  color: var(--t3);
}

.tip-text {
  margin: 0 40rpx;
  font-size: 23rpx;
  color: var(--t3);
  line-height: 1.7;
}

.save-section {
  padding: 50rpx 40rpx 0;
}

.save-btn {
  background: var(--grad-primary);
  color: #fff;
  border-radius: 20rpx;
  padding: 26rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
  box-shadow: 0 8rpx 20rpx rgba(91, 103, 241, 0.25);
}

.save-btn::after {
  border: none;
}

.save-btn:active {
  opacity: 0.9;
}

.save-btn[disabled] {
  opacity: 0.6;
}
