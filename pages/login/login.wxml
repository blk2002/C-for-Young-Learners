<!-- pages/login/login.wxml -->
<view class="login-page">
  <!-- 品牌区 -->
  <view class="brand">
    <view class="brand-logo">
      <text class="icon i-book-w brand-logo-ico"/>
    </view>
    <view class="brand-name">少儿编程课程</view>
    <view class="brand-slogan">开启你的编程之旅</view>
  </view>

  <!-- 表单卡片 -->
  <view class="auth-card">
    <!-- 账号 -->
    <view class="field">
      <view class="field-label">账号</view>
      <view class="field-box {{focusField === 'username' ? 'focus' : ''}}">
        <text class="icon i-user field-ico"/>
        <input
          class="field-input"
          placeholder="请输入账号"
          placeholder-class="field-placeholder"
          value="{{username}}"
          bindinput="onUsernameInput"
          bindfocus="onFocus"
          bindblur="onBlur"
          data-field="username"
          maxlength="20"
        />
      </view>
    </view>

    <!-- 密码 -->
    <view class="field">
      <view class="field-label">密码</view>
      <view class="field-box {{focusField === 'password' ? 'focus' : ''}}">
        <text class="icon i-shield field-ico"/>
        <input
          class="field-input"
          placeholder="请输入密码"
          placeholder-class="field-placeholder"
          value="{{password}}"
          bindinput="onPasswordInput"
          bindfocus="onFocus"
          bindblur="onBlur"
          data-field="password"
          password="true"
          maxlength="20"
        />
      </view>
    </view>

    <!-- 提交按钮 -->
    <button
      class="btn-primary submit-btn"
      bindtap="onSubmit"
      disabled="{{loading}}"
      loading="{{loading}}"
    >登 录</button>
  </view>

  <!-- 页脚 -->
  <view class="page-foot">账号由老师发放，忘记密码请联系老师</view>
</view>
