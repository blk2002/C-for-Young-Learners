/* pages/lesson/lesson.wxss */
.container {
  padding: 0;
  min-height: 100vh;
  background: var(--bg);
}

/* 操作栏 */
.header-actions {
  display: flex;
  justify-content: flex-end;
  padding: 20rpx 40rpx;
  background: #fff;
  border-bottom: 1rpx solid var(--line);
}

.action-btn {
  background: var(--bg);
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: var(--t2);
}

.action-btn.active {
  background: var(--danger-tint);
  color: var(--danger);
}

/* 标题 */
.lesson-title {
  padding: 40rpx 40rpx 20rpx;
  font-size: 40rpx;
  font-weight: bold;
  color: var(--t1);
  background: #fff;
  margin-bottom: 20rpx;
}

/* 通用 section */
.section {
  background: #fff;
  padding: 30rpx 40rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--t1);
  margin-bottom: 24rpx;
}

/* 内容文字 */
.content-text {
  font-size: 28rpx;
  line-height: 1.8;
  color: var(--t2);
  white-space: pre-wrap; /* 让 content 里的换行正常显示 */
}

/* 代码区域 */
.code-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.copy-btn {
  background: var(--primary);
  color: #fff;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.code-block {
  background: #2A2D3E;
  color: #F8F8F2;
  border-radius: 12rpx;
  padding: 24rpx;
  font-family: 'Courier New', monospace;
  font-size: 24rpx;
  line-height: 1.8;
  overflow-x: auto;
  white-space: pre-wrap;
  word-break: break-all;
}

/* 提示文字 */
.hint-text {
  font-size: 24rpx;
  color: var(--t3);
  margin-bottom: 20rpx;
}

/* 题目卡片 */
.question-card {
  background: var(--bg);
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--line);
}

.question-number {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--primary);
  margin-bottom: 10rpx;
  display: inline-block;
  margin-right: 12rpx;
}

.question-type-tag {
  display: inline-block;
  background: var(--tint);
  color: var(--primary);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  margin-bottom: 20rpx;
}

.question-type-tag.fill {
  background: var(--warning-tint);
  color: var(--warning);
}

.question-text {
  font-size: 28rpx;
  color: var(--t1);
  line-height: 1.7;
  margin-bottom: 24rpx;
}

/* 选项 */
.options {
  margin-bottom: 20rpx;
}

.option-item {
  background: #fff;
  border: 2rpx solid var(--line);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  transition: all 0.2s;
}

.option-item:active {
  background: var(--line);
}

.option-item.selected {
  border-color: var(--primary);
  background: var(--tint);
}

.option-letter {
  width: 50rpx;
  height: 50rpx;
  background: var(--line);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--t2);
  margin-right: 20rpx;
  flex-shrink: 0;
}

.option-item.selected .option-letter {
  background: var(--primary);
  color: #fff;
}

.option-text {
  flex: 1;
  font-size: 28rpx;
  color: var(--t1);
}

/* 填空题输入 */
.fill-input-wrap {
  margin-bottom: 20rpx;
}

.fill-input-wrap .input {
  background: #fff;
  border: 2rpx solid var(--line);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
}

/* 显示/隐藏答案 */
.answer-toggle {
  text-align: center;
  padding: 20rpx;
  color: var(--primary);
  font-size: 26rpx;
  background: var(--tint);
  border-radius: 12rpx;
  margin-top: 10rpx;
}

.answer-toggle:active {
  background: var(--tint);
}

/* 答案区域 */
.answer-section {
  margin-top: 24rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 12rpx;
  border-left: 6rpx solid var(--ok);
}

.answer-label,
.explanation-label {
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.answer-label {
  color: var(--ok);
}

.explanation-label {
  color: var(--warning);
  margin-top: 20rpx;
}

.answer-text {
  font-size: 28rpx;
  color: var(--t1);
  line-height: 1.6;
  padding-left: 10rpx;
}

.explanation-text {
  font-size: 28rpx;
  color: var(--t2);
  line-height: 1.6;
  padding-left: 10rpx;
}

/* 空文字 */
.empty-text {
  text-align: center;
  padding: 40rpx 0;
  color: var(--t3);
  font-size: 26rpx;
}

.loading {
  text-align: center;
  padding: 100rpx 0;
  color: var(--t3);
}
