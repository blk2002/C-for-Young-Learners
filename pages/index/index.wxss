/* pages/index/index.wxss */
.container {
  padding: 0;
}

/* 欢迎区域 */
.hero-section {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-deep) 100%);
  padding: 48rpx 40rpx 36rpx;
  color: #fff;
  position: relative;
  overflow: hidden;
}

.hero-deco {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
  pointer-events: none;
}

.deco-1 {
  width: 220rpx;
  height: 220rpx;
  top: -80rpx;
  right: -40rpx;
}

.deco-2 {
  width: 140rpx;
  height: 140rpx;
  bottom: -50rpx;
  left: -30rpx;
  background: rgba(255, 255, 255, 0.05);
}

.hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
  z-index: 1;
}

.hero-text {
  flex: 1;
  min-width: 0;
}

.hello {
  font-size: 34rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 26rpx;
  opacity: 0.9;
}

.hero-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  border: 2rpx solid rgba(255, 255, 255, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
  flex-shrink: 0;
  margin-left: 24rpx;
}

.hero-avatar:active {
  opacity: 0.7;
}

/* 学习进度 */
.progress-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 32rpx;
  position: relative;
  z-index: 1;
}

.progress-label {
  font-size: 24rpx;
  opacity: 0.9;
}

.progress-course {
  font-size: 24rpx;
  font-weight: 600;
}

.progress-bar {
  height: 10rpx;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 5rpx;
  margin-top: 12rpx;
  overflow: hidden;
  position: relative;
  z-index: 1;
}

.progress-fill {
  height: 100%;
  background: #fff;
  border-radius: 5rpx;
  transition: width 0.4s;
}

.progress-meta {
  font-size: 22rpx;
  opacity: 0.85;
  margin-top: 10rpx;
  position: relative;
  z-index: 1;
}

/* 无学习进度时的空态 */
.progress-empty {
  margin-top: 28rpx;
  position: relative;
  z-index: 1;
}

.empty-tip {
  font-size: 24rpx;
  opacity: 0.85;
  margin-top: 8rpx;
}

/* 课程区域 */
.section-title {
  padding: 40rpx 40rpx 20rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--t1);
}

.courses {
  padding: 0 40rpx;
}

.course-card {
  border-radius: 20rpx;
  padding: 50rpx 40rpx;
  margin-bottom: 30rpx;
  position: relative;
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(91, 103, 241, 0.3);
  transition: transform 0.2s;
}

.course-card:active {
  transform: scale(0.98);
}

.course-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.course-name {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.course-desc {
  font-size: 26rpx;
  opacity: 0.9;
}

.course-arrow {
  position: absolute;
  right: 40rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 60rpx;
  opacity: 0.6;
}

/* 提示区域 */
.tip-section {
  padding: 20rpx 40rpx 40rpx;
}

.tip-card {
  background: var(--warning-tint);
  border-radius: 16rpx;
  padding: 30rpx;
  display: flex;
  align-items: flex-start;
}

.tip-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
}

.tip-content {
  flex: 1;
}

.tip-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--warning);
  margin-bottom: 8rpx;
}

.tip-text {
  font-size: 24rpx;
  color: var(--t3);
  line-height: 1.6;
}
