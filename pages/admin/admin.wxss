/* pages/admin/admin.wxss */
.container {
  padding: 0;
  min-height: 100vh;
}

.header {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-deep) 100%);
  padding: 50rpx 40rpx;
  color: #fff;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 26rpx;
  opacity: 0.9;
}

/* Tabs */
.tabs {
  display: flex;
  background: #fff;
  margin-bottom: 20rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  font-size: 28rpx;
  color: var(--t2);
  position: relative;
}

.tab.active {
  color: var(--primary);
  font-weight: 600;
}

.tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background: var(--primary);
  border-radius: 2rpx;
}

.badge {
  background: var(--danger);
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  margin-left: 8rpx;
}

.content {
  padding: 20rpx 40rpx;
}

/* 用户卡片 */
.user-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.user-avatar {
  width: 80rpx;
  height: 80rpx;
  background: var(--tint);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 24rpx;
}

.user-info {
  flex: 1;
}

.username {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--t1);
  margin-bottom: 6rpx;
}

.user-meta {
  font-size: 24rpx;
  color: var(--warning);
}

.user-actions {
  display: flex;
  gap: 16rpx;
}

.btn-approve {
  background: var(--ok);
  color: #fff;
  padding: 12rpx 24rpx;
  border-radius: 10rpx;
  font-size: 26rpx;
}

.btn-reject {
  background: var(--danger);
  color: #fff;
  padding: 12rpx 24rpx;
  border-radius: 10rpx;
  font-size: 26rpx;
}

/* 课程选择器 */
.course-selector {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 12rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.course-tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 0;
  margin: 0 8rpx;
  font-size: 28rpx;
  color: var(--t2);
  border-radius: 12rpx;
  background: var(--bg);
  transition: all 0.3s;
}

.course-tab.active {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-deep) 100%);
  color: #fff;
  font-weight: 500;
}

/* 章节列表 */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--t1);
}

/* 章节汇总卡（方案 C） */
.chapter-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.summary-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.summary-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background: var(--grad-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.summary-icon .icon {
  font-size: 36rpx;
  line-height: 1;
}

.summary-info {
  flex: 1;
  min-width: 0;
}

.summary-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--t1);
  margin-bottom: 6rpx;
}

.summary-sub {
  font-size: 24rpx;
  color: var(--t3);
}

.summary-btn {
  flex-shrink: 0;
  background: var(--tint);
  color: var(--primary);
  padding: 16rpx 28rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
}

.summary-btn:active {
  opacity: 0.6;
}

.summary-plus {
  font-size: 30rpx;
  font-weight: 700;
  margin-right: 4rpx;
  line-height: 1;
}

.chapter-list {
  padding-bottom: 40rpx;
}

.chapter-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.chapter-info {
  margin-bottom: 20rpx;
}

.chapter-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--t1);
  margin-bottom: 8rpx;
}

.chapter-order {
  font-size: 24rpx;
  color: var(--t3);
}

.chapter-actions {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  padding: 14rpx 24rpx;
  border-radius: 10rpx;
  font-size: 26rpx;
  flex: 1;
  text-align: center;
}

.action-btn.blue {
  background: var(--tint);
  color: var(--primary);
}

.action-btn.green {
  background: var(--ok-tint);
  color: var(--ok);
}

.action-btn.red {
  background: var(--danger-tint);
  color: var(--danger);
}

.loading {
  text-align: center;
  padding: 100rpx 0;
  color: var(--t3);
}

.empty-state {
  text-align: center;
  padding: 120rpx 30rpx;
}

.empty-state .icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.empty-state .text {
  font-size: 28rpx;
  color: var(--t3);
}

/* 习题管理入口卡片 */
.exercise-entry-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.exercise-entry-card:active {
  background: var(--bg);
}

.entry-icon {
  font-size: 60rpx;
  margin-right: 24rpx;
  width: 80rpx;
  text-align: center;
}

.entry-content {
  flex: 1;
}

.entry-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--t1);
  margin-bottom: 8rpx;
}

.entry-desc {
  font-size: 26rpx;
  color: var(--t3);
}

.entry-arrow {
  font-size: 48rpx;
  color: var(--t3);
}

.exercise-entry-card.disabled {
  opacity: 0.5;
}

.exercise-entry-card.disabled:active {
  background: #fff;
}

/* ===== 学生管理 ===== */
.add-btn {
  background: var(--grad-primary);
  color: #fff;
  border-radius: 20rpx;
  padding: 24rpx 0;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 20rpx rgba(91, 103, 241, 0.25);
}

.add-btn:active {
  opacity: 0.9;
}

.filter-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.filter-item {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 24rpx;
  border-radius: 16rpx;
  background: var(--panel-2);
  color: var(--t3);
}

.filter-item.on {
  background: var(--primary);
  color: #fff;
  font-weight: 600;
}

.student-card {
  background: var(--panel);
  border-radius: 20rpx;
  padding: 26rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-sm);
}

.student-top {
  display: flex;
  align-items: center;
}

.student-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: var(--panel-2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  flex: none;
  overflow: hidden;
}

.avatar-img {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
}

.student-info {
  flex: 1;
  margin-left: 20rpx;
  overflow: hidden;
}

.student-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--t1);
}

.student-account {
  font-size: 23rpx;
  color: var(--t3);
  margin-top: 2rpx;
}

.expire-tag {
  flex: none;
  font-size: 21rpx;
  font-weight: 600;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  background: var(--ok-tint);
  color: var(--ok);
}

.expire-tag.permanent {
  background: var(--tint);
  color: var(--primary);
}

.expire-tag.soon {
  background: var(--warning-tint);
  color: #B8700F;
}

.expire-tag.expired {
  background: var(--danger-tint);
  color: var(--danger);
}

.student-validity {
  font-size: 23rpx;
  color: var(--t3);
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--line);
}

.student-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 20rpx;
}

.student-actions .action-btn {
  flex: 1;
  text-align: center;
  margin: 0;
}
