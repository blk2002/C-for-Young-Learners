<!-- pages/admin/admin.wxml -->
<view class="container">
  <view class="header">
    <view class="title"><text class="icon i-tool-w"/> 管理后台</view>
    <view class="subtitle">学生账号管理</view>
  </view>

  <view class="loading" wx:if="{{loading}}">加载中...</view>

  <!-- 学生管理 -->
  <view class="content">
    <!-- 新建按钮 -->
    <view class="add-btn" bindtap="goToCreateStudent">+ 新建学生账号</view>

    <!-- 筛选 -->
    <view class="filter-bar">
      <view
        class="filter-item {{studentFilter === 'all' ? 'on' : ''}}"
        data-filter="all"
        bindtap="switchStudentFilter"
      >全部 {{filterCount.all}}</view>
      <view
        class="filter-item {{studentFilter === 'soon' ? 'on' : ''}}"
        data-filter="soon"
        bindtap="switchStudentFilter"
      >即将到期 {{filterCount.soon}}</view>
      <view
        class="filter-item {{studentFilter === 'expired' ? 'on' : ''}}"
        data-filter="expired"
        bindtap="switchStudentFilter"
      >已过期 {{filterCount.expired}}</view>
    </view>

    <!-- 学生列表 -->
    <block wx:if="{{displayStudents.length > 0}}">
      <view class="student-card" wx:for="{{displayStudents}}" wx:key="_id">
        <view class="student-top">
          <view class="student-avatar">
            <image wx:if="{{item.avatar}}" class="avatar-img" src="{{item.avatar}}" mode="aspectFill" />
            <text wx:else class="icon i-user"/>
          </view>
          <view class="student-info">
            <view class="student-name">{{item.name}}</view>
            <view class="student-account">{{item.username}}</view>
          </view>
          <view class="expire-tag {{item.expireState}}">
            <block wx:if="{{item.expireState === 'permanent'}}">永久有效</block>
            <block wx:elif="{{item.expireState === 'expired'}}">已过期</block>
            <block wx:elif="{{item.expireState === 'soon'}}">{{item.remainDays}}天后到期</block>
            <block wx:else>有效</block>
          </view>
        </view>

        <view class="student-validity">{{item.validityText}}</view>

        <view class="student-actions">
          <view class="action-btn blue" data-id="{{item._id}}" data-name="{{item.name}}" bindtap="resetPassword">重置密码</view>
          <view class="action-btn" data-id="{{item._id}}" data-name="{{item.name}}" bindtap="renewStudent">续期</view>
          <view class="action-btn red" data-id="{{item._id}}" data-name="{{item.name}}" bindtap="deleteStudent">删除</view>
        </view>
      </view>
    </block>

    <view class="empty-state" wx:else>
      <view class="icon"><text class="icon i-users"/></view>
      <view class="text">{{studentList.length > 0 ? '该分类下没有学生' : '还没有学生账号'}}</view>
      <view class="text" style="font-size: 24rpx; margin-top: 10rpx;">点击上方"新建学生账号"添加</view>
    </view>
  </view>

  <view class="bottom-space"></view>
</view>
