.container {
  padding: 30rpx;
  background: var(--bg);
  min-height: 100vh;
}

.page-title {
  font-size: 40rpx;
  font-weight: bold;
  color: var(--t1);
  margin-bottom: 10rpx;
}

.page-subtitle {
  font-size: 26rpx;
  color: var(--t3);
  margin-bottom: 40rpx;
}

.exam-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.exam-card {
  display: flex;
  align-items: center;
  padding: 40rpx 30rpx;
  border-radius: 20rpx;
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.12);
  transition: transform 0.2s;
}

.exam-card:active {
  transform: scale(0.98);
}

.exam-icon {
  font-size: 80rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.exam-info {
  flex: 1;
  min-width: 0;
}

.exam-name {
  font-size: 34rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.exam-desc {
  font-size: 24rpx;
  opacity: 0.9;
}

.exam-arrow {
  font-size: 60rpx;
  opacity: 0.7;
  flex-shrink: 0;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #EEEFF7;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  color: #9AA3C0;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 30rpx;
  color: var(--t2);
  font-weight: 500;
  margin-bottom: 12rpx;
}

.empty-sub {
  font-size: 24rpx;
  color: var(--t3);
  text-align: center;
  line-height: 1.6;
}
