/* pages/admin-edit/admin-edit.wxss */
.container {
  padding: 0;
  min-height: 100vh;
}

.loading {
  text-align: center;
  padding: 100rpx 0;
  color: var(--t3);
}

/* 表单容器 */
.form-container {
  padding: 30rpx 40rpx;
}

.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.form-item {
  margin-bottom: 30rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--t1);
  margin-bottom: 16rpx;
}

.label-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.label-row .label {
  margin-bottom: 0;
}

.help-btn {
  font-size: 24rpx;
  color: var(--primary);
  background: var(--tint);
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
}

.input {
  background: var(--bg);
  border-radius: 12rpx;
  padding: 24rpx 30rpx;
  font-size: 28rpx;
}

.textarea {
  background: var(--bg);
  border-radius: 12rpx;
  padding: 24rpx 30rpx;
  font-size: 28rpx;
  width: 100%;
  box-sizing: border-box;
  min-height: 180rpx;
  line-height: 1.6;
}

.textarea.code {
  font-family: 'Courier New', monospace;
  background: #2A2D3E;
  color: #F8F8F2;
  min-height: 240rpx;
}

.save-btn {
  margin-top: 20rpx;
}

/* 知识点列表样式 */
.lessonlist-container {
  padding: 30rpx 40rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--t1);
}

.add-btn {
  background: var(--primary);
  color: #fff;
  padding: 12rpx 24rpx;
  border-radius: 10rpx;
  font-size: 26rpx;
}

.lesson-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.lesson-info {
  margin-bottom: 20rpx;
}

.lesson-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--t1);
  margin-bottom: 8rpx;
}

.lesson-meta {
  font-size: 24rpx;
  color: var(--t3);
}

.lesson-actions {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  padding: 14rpx 24rpx;
  border-radius: 10rpx;
  font-size: 26rpx;
  flex: 1;
  text-align: center;
}

.action-btn.green {
  background: var(--ok-tint);
  color: var(--ok);
}

.action-btn.red {
  background: var(--danger-tint);
  color: var(--danger);
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 120rpx 30rpx;
}

.empty-state .icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.empty-state .text {
  font-size: 28rpx;
  color: var(--t3);
}

/* ========== 练习题管理 ========== */

.question-count {
  font-size: 26rpx;
  color: var(--t2);
  font-weight: normal;
}

.question-add-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.add-question-btn {
  flex: 1;
  background: var(--tint);
  color: var(--primary);
  padding: 20rpx;
  border-radius: 12rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 500;
  border: 2rpx dashed var(--primary);
}

.add-question-btn:active {
  background: var(--tint);
}

.question-list {
  margin-top: 10rpx;
}

.question-item {
  background: var(--bg);
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  border-left: 6rpx solid var(--primary);
}

.question-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.question-index {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--t1);
  margin-right: 16rpx;
}

.question-type-tag {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: var(--tint);
  color: var(--primary);
}

.question-type-tag.fill {
  background: var(--warning-tint);
  color: var(--warning);
}

.question-preview {
  font-size: 28rpx;
  color: var(--t2);
  line-height: 1.5;
  margin-bottom: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.question-actions {
  display: flex;
  gap: 12rpx;
}

.q-action-btn {
  padding: 10rpx 20rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  text-align: center;
}

.q-action-btn.blue {
  background: var(--tint);
  color: var(--primary);
}

.q-action-btn.orange {
  background: var(--warning-tint);
  color: var(--warning);
}

.q-action-btn.red {
  background: var(--danger-tint);
  color: var(--danger);
}

.empty-questions {
  text-align: center;
  padding: 60rpx 20rpx;
  background: var(--bg);
  border-radius: 12rpx;
}

.empty-questions .empty-text {
  font-size: 28rpx;
  color: var(--t3);
  margin-bottom: 8rpx;
}

.empty-questions .empty-hint {
  font-size: 24rpx;
  color: var(--t3);
}

/* ========== 弹窗 ========== */

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-content {
  width: 90%;
  max-height: 85vh;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid var(--line);
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--t1);
}

.modal-close {
  font-size: 36rpx;
  color: var(--t3);
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-body {
  padding: 30rpx;
  overflow-y: auto;
  flex: 1;
}

.modal-body .form-item {
  margin-bottom: 24rpx;
}

.modal-body .form-item:last-child {
  margin-bottom: 0;
}

.modal-footer {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 30rpx;
  border-top: 1rpx solid var(--line);
}

.modal-footer button {
  flex: 1;
  margin: 0;
}

.btn-secondary {
  background: var(--bg);
  color: var(--t2);
  font-size: 28rpx;
}

.btn-primary {
  background: var(--primary);
  color: #fff;
  font-size: 28rpx;
}

/* 题目类型选择 */
.type-selector {
  display: flex;
  gap: 20rpx;
}

.type-option {
  flex: 1;
  padding: 20rpx;
  text-align: center;
  border: 2rpx solid var(--line);
  border-radius: 12rpx;
  font-size: 28rpx;
  color: var(--t2);
  background: #fff;
}

.type-option.active {
  border-color: var(--primary);
  background: var(--tint);
  color: var(--primary);
  font-weight: 500;
}

/* 答案选择 */
.answer-selector {
  display: flex;
  gap: 16rpx;
}

.answer-option {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid var(--line);
  border-radius: 50%;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--t2);
  background: #fff;
}

.answer-option.active {
  border-color: var(--primary);
  background: var(--primary);
  color: #fff;
}
