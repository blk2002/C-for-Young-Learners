.container {
  padding: 30rpx;
  background: var(--bg);
  min-height: 100vh;
  padding-bottom: 180rpx;
}

.progress-bar {
  margin-bottom: 30rpx;
}

.progress-text {
  font-size: 26rpx;
  color: var(--t2);
  margin-bottom: 12rpx;
  text-align: center;
}

.progress-track {
  height: 12rpx;
  background: var(--line);
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--primary), var(--primary-deep));
  border-radius: 6rpx;
  transition: width 0.3s;
}

.question-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  margin-bottom: 30rpx;
}

.question-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid var(--line);
}

.question-number {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--t1);
}

.question-type {
  font-size: 22rpx;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  color: #fff;
}

.type-choice {
  background: var(--primary);
}

.type-fill {
  background: var(--ok);
}

.question-content {
  font-size: 32rpx;
  color: var(--t1);
  line-height: 1.7;
  margin-bottom: 30rpx;
  word-break: break-all;
  white-space: normal;
}

.option-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.option-item {
  display: flex;
  align-items: flex-start;
  padding: 24rpx;
  background: var(--bg);
  border: 2rpx solid var(--line);
  border-radius: 16rpx;
  transition: all 0.2s;
}

.option-item.selected {
  background: var(--tint);
  border-color: var(--primary);
}

.option-item.correct {
  background: var(--ok-tint);
  border-color: var(--ok);
}

.option-item.wrong {
  background: var(--danger-tint);
  border-color: var(--danger);
}

.option-circle {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #fff;
  border: 2rpx solid var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: var(--t2);
  margin-right: 20rpx;
  flex-shrink: 0;
  font-weight: bold;
}

.option-item.selected .option-circle {
  background: var(--primary);
  border-color: var(--primary);
  color: #fff;
}

.option-item.correct .option-circle {
  background: var(--ok);
  border-color: var(--ok);
  color: #fff;
}

.option-item.wrong .option-circle {
  background: var(--danger);
  border-color: var(--danger);
  color: #fff;
}

.option-text {
  flex: 1;
  font-size: 30rpx;
  color: var(--t1);
  line-height: 1.6;
  word-break: break-all;
  white-space: normal;
}

.option-icon {
  margin-left: 16rpx;
  color: var(--ok);
  font-size: 32rpx;
  font-weight: bold;
  flex-shrink: 0;
}

.option-icon.wrong-icon {
  color: var(--danger);
}

.fill-input-wrap {
  margin-bottom: 20rpx;
}

.fill-input {
  width: 100%;
  height: 90rpx;
  padding: 0 24rpx;
  background: var(--bg);
  border: 2rpx solid var(--line);
  border-radius: 12rpx;
  font-size: 30rpx;
  color: var(--t1);
}

.answer-result {
  margin-top: 30rpx;
  padding-top: 30rpx;
  border-top: 1rpx solid var(--line);
}

.result-status {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.result-status.correct {
  color: var(--ok);
}

.result-status.wrong {
  color: var(--danger);
}

.answer-detail {
  background: var(--tint);
  padding: 20rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.detail-label {
  font-size: 26rpx;
  color: var(--t2);
  margin-bottom: 8rpx;
}

.detail-value {
  font-size: 28rpx;
  color: var(--primary);
  font-weight: 500;
  word-break: break-all;
}

.explanation {
  background: var(--warning-tint);
  padding: 20rpx;
  border-radius: 12rpx;
}

.exp-label {
  font-size: 26rpx;
  color: var(--warning);
  margin-bottom: 8rpx;
  font-weight: 500;
}

.exp-text {
  font-size: 26rpx;
  color: var(--t2);
  line-height: 1.6;
  word-break: break-all;
}

.nav-buttons {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 30rpx;
  background: #fff;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.nav-btn {
  flex: 1;
  font-size: 30rpx;
  border-radius: 12rpx;
  height: 88rpx;
  line-height: 88rpx;
  border: none;
}

.prev-btn {
  background: var(--bg);
  color: var(--t2);
}

.prev-btn[disabled] {
  opacity: 0.5;
}

.next-btn {
  background: var(--primary);
  color: #fff;
}

.submit-btn {
  background: var(--ok);
  color: #fff;
}

.submit-score {
  position: fixed;
  bottom: 130rpx;
  left: 30rpx;
  right: 30rpx;
  background: linear-gradient(135deg, var(--primary), var(--primary-deep));
  color: #fff;
  padding: 30rpx;
  border-radius: 16rpx;
  text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(91, 103, 241, 0.4);
}

.score-text {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.score-rate {
  font-size: 26rpx;
  opacity: 0.9;
}

.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
}

.loading-text {
  font-size: 28rpx;
  color: var(--t3);
}
